# Copy this file to `.env` for local development.
# Never commit `.env` or real credentials to the repository.
#
# Generate strong secrets with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"

# Domain
# In production this is the base domain used by Traefik.
DOMAIN=localhost
# To test local subdomains with Traefik, configure your hosts file and use:
# DOMAIN=terraquorum.local

# Local Docker ports (host). Adjust if they conflict with other projects.
FRONTEND_PORT=5173
BACKEND_PORT=8000
MONGO_EXPRESS_PORT=8081
MAILCATCHER_WEB_PORT=1080
MAILCATCHER_SMTP_PORT=1025
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8090
PLAYWRIGHT_REPORT_PORT=9323

# Used by the backend to generate links in emails to the frontend.
# Keep in sync with FRONTEND_PORT.
FRONTEND_HOST=http://localhost:5173

# Environment: local, staging, production
ENVIRONMENT=local
CI=false

PROJECT_NAME="TerraQuorum"
STACK_NAME=terra_quorum

# Backend
# If you change FRONTEND_PORT, update the localhost URLs here too.
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://api.terraquorum.local,http://dashboard.terraquorum.local"
SECRET_KEY=replace-with-a-generated-secret-key
# Local demo admin user. Replace before any shared or public deployment.
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-admin-password

# Emails
# Leave SMTP_HOST empty in local development if you use Mailcatcher.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# MongoDB
# MONGODB_PORT is the host port published by Docker (change if 27017 is taken).
# Inside containers the backend always connects to db:27017.
MONGODB_SERVER=localhost
MONGODB_PORT=27017
MONGODB_DB=terraquorum_db
MONGODB_USER=terraquorum_user
MONGODB_PASSWORD=replace-with-a-strong-mongodb-password

# Observability
SENTRY_DSN=

# Docker images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
TAG=latest

# AI provider API keys
# Configure only the providers you plan to use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GOOGLE_API_KEY=
